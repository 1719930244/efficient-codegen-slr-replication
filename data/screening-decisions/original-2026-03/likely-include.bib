@inproceedings{ieee_Liu2026evolutionary,
  title     = {Evolutionary Computation-enhanced Large Language Models for Intelligent Code Completion},
  author    = {Dongbo Liu and Ziqi Tan and Gary G. Yen and Suling Duan and Yimin Zhou and Zhenan He},
  year      = {2026},
  booktitle = {IEEE Transactions on Evolutionary Computation},
  volume    = {PP},
